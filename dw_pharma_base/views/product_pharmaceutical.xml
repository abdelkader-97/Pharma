<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_pharma_pf_dest_view_tree" model="ir.ui.view">
        <field name="name">product.pharmaceutical.pf.dest.tree</field>
        <field name="model">product.pharmaceutical.pf.dest</field>
        <field name="arch" type="xml">
            <list string="PF Destination" editable="top">
                <field name="name"/>
                <field name="description"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
            </list>
        </field>
    </record>
    <record id="action_product_pharmaceutical_pf_dest" model="ir.actions.act_window">
        <field name="name">PF destination</field>
        <field name="res_model">product.pharmaceutical.pf.dest</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No destination found. Let's create one!
            </p>
        </field>
    </record>

    <record id="product_pharma_family_view_form" model="ir.ui.view">
        <field name="name">product.pharmaceutical.family.form</field>
        <field name="model">product.pharmaceutical.family</field>
        <field name="arch" type="xml">
            <form string="Family">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" string="Products" name="action_view_product" class="oe_stat_button"
                                icon="fa-tags">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div>
                            <label for="name"/>
                        </div>
                        <h1 class="mb32">
                            <field name="name" placeholder="e.g. Family .." class="mb16"/>
                        </h1>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>

                    </div>
                    <notebook>
                        <page string="SubFamily">
                            <field name="subfamily_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuration">
                            <group>
                                <field name="purchase_ok"/>
                                <field name="sale_ok"/>
                                <field name="product_categ_id" options="{'no_create': True}"/>
                                <field name="product_detailed_type"/>
                                <field name="is_storable" invisible="product_detailed_type != 'consu'"/>
                                <field name="tracking" invisible="not is_storable"/>
                                <field name="use_expiration_date"/>
                            </group>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

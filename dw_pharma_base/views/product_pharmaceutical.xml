    <record id="product_pharma_form_view_form" model="ir.ui.view">
        <field name="name">product.pharmaceutical.form.form</field>
        <field name="model">product.pharmaceutical.form</field>
        <field name="arch" type="xml">
            <form string="Form">
                <div class="oe_title">
                    <div>
                        <label for="name"/>
                    </div>
                    <h1 class="mb32">
                        <field name="name" placeholder="e.g. Form .." class="mb16"/>
                    </h1>
                </div>
                <group>
                    <field name="code"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="active" invisible="1"/>
                </group>
                <notebook>
                    <page string="SubForm">
                        <field name="subform_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="product_pharma_form_view_tree" model="ir.ui.view">

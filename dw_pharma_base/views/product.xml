<?xml version="1.0"?>
<odoo>
    <record id="product_template_pharma_form_view" model="ir.ui.view">
        <field name="name">product.template.pharma.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="pharma" string="Pharma">
                    <group>
                        <group>
                            <field name="dw_pharma_dci"/>
                            <field name="dw_pharma_regis_num"/>
                            <field name="dw_pharma_network_id" options="{'no_create':True}"/>
                            <label for="dw_pharma_duration"/>
                            <div name="dw_pharma_duration_div">
                                <field name="dw_pharma_duration" class="oe_inline"/>
                                <span>
                                    <field name="dw_pharma_duration_unit" class="oe_inline"/>
                                </span>
                            </div>
                        </group>
                        <group>
                            <field name="dw_pharma_date_de"/>
                            <field name="dw_pharma_pf_dest_id" options="{'no_create':True}"/>
                            <field name="dw_pharma_dosage_id" options="{'no_create':True}"/>
                            <field name="dw_pharma_speciality_product_id" options="{'no_create':True}"/>
                        </group>
                        <group string="Family">
                            <field name="dw_pharma_family_id" options="{'no_create':True}"/>
                            <field name="dw_pharma_subfamily_id" options="{'no_create':True}"
                                   domain="[('family_id', '=', dw_pharma_family_id)]"/>
                        </group>
                        <group string="Form">
                            <field name="dw_pharma_form_id" options="{'no_create':True}"/>
                            <field name="dw_pharma_subform_id" options="{'no_create':True}"
                                   domain="[('form_id', '=', dw_pharma_form_id)]"/>
                        </group>
                        <group string="Class">
                            <field name="dw_pharma_class_id" options="{'no_create':True}"/>
                            <field name="dw_pharma_subclass_id" options="{'no_create':True}"
                                   domain="[('class_id', '=', dw_pharma_class_id)]"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="dw_price_ppa" invisible="not sale_ok"/>
                <div name="dw_price_ppa_price_uom" invisible="not sale_ok">
                    <field name="dw_price_ppa" class="oe_inline" widget="monetary"/>
                    <span groups="uom.group_uom">per
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
                <label for="dw_price_pua"/>
                <div name="dw_price_pua_ppa_price_uom">
                    <field name="dw_price_pua" class="oe_inline" widget="monetary"/>
                    <span groups="uom.group_uom">per
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
                <label for="dw_price_wholesaler" invisible="not sale_ok"/>
                <div name="dw_price_wholesaler_price_uom" invisible="not sale_ok">
                    <field name="dw_price_wholesaler" class="oe_inline" widget="monetary" />
                    <span groups="uom.group_uom">per
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
            </xpath>
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group>
                    <field name="dw_commercial_name"/>
                    <field name="dw_is_blocked"/>
                    <field name="dw_blacklist_date" invisible="not dw_is_blocked" required="dw_is_blocked"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mrp_production_form" model="ir.ui.view">
        <field name="name">mrp_production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_mark_done']" position="after">
                <field name="dw_leftover_done" invisible="1"/>
                <button name="action_create_picking_request" class="btn-info" type="object" string="Return leftovers"
                        invisible="dw_leftover_done == True or state != 'done'"
                />
            </xpath>
            <xpath expr="//button[@name='action_assign']" position="after">
                <field name="product_request_needed" invisible="1"/>
                <button name="action_request_products" type="object" string="Request Product" class="btn-danger"
                        invisible="product_request_needed == False or state in ('draft', 'done', 'cancel')"
                />
            </xpath>
            <xpath expr="//notebook//field[@name='move_raw_ids']" position="before">
                <button name="additional_consumption" class="btn-info" type="object" string="additional consumption"
                        invisible="state in ['draft','done','cancel']"/>

            </xpath>
            <xpath expr="//button[@name='action_view_mo_delivery']" position="after">
                <button class="oe_stat_button" name="action_view_product_request" type="object" icon="fa-list">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="mrp_product_request_count"/>
                        </span>
                        <span class="o_stat_text">Requests</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
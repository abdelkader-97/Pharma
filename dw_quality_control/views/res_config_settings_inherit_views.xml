<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.quality.compliance</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <setting id="quality_control" position="after">
                    <setting id="quality_control_compliance_lot" help="Lot quality Compliance Process"
                             invisible="not module_quality_control">
                        <field name="module_dw_quality_lot_process"/>
                    </setting>
                </setting>
            </field>
        </record>
    </data>
</odoo>
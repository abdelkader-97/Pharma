<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dw_view_location_quality_form_inherit" model="ir.ui.view">
        <field name="name">stock.location.quality.form.inherit</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="inside">
                <group string="Quality" name="quality">
                    <field name="dw_is_quarantine"/>
                </group>
            </xpath>
        </field>
    </record>
            <record id="stock_lot_tree_view_inherited_qc" model="ir.ui.view">
            <field name="name">stcok.lot.tree.inherited</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="dw_date_production"/>
                </xpath>

            </field>
        </record>
     <record id="stock_lot_form_view_inherited_qc" model="ir.ui.view">
            <field name="name">stcok.lot.form.inherited</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form/sheet/group/group//field[@name='product_id']" position="after">
                    <field name="dw_date_production"/>
                </xpath>

            </field>
        </record>
</odoo>

<odoo>
    <record id="dw_sampling_view_tree" model="ir.ui.view">
        <field name="name">dw.quality.sampling.view.tree</field>
        <field name="model">dw.quality.sampling</field>
        <field name="arch" type="xml">
            <list string="Sampling">
                <field name="name"/>
                <field name="sampling_date"/>
                <field name="product_id"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <record id="dw_sampling_view_form" model="ir.ui.view">
        <field name="name">dw.quality.sampling.view.form</field>
        <field name="model">dw.quality.sampling</field>
        <field name="arch" type="xml">
            <form string="Sampling">
                <sheet>
                    <h2><field name="name" readonly="1"/></h2>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create':True}"/>
                            <field name="product_tmpl_id" options="{'no_create':True}" invisible="1"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_uom_id" options="{'no_open':True,'no_create':True}"/>
                        </group>
                        <group>
                            <field name="sampling_date"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                            <page string="Components" name="components">
                                <field name="dw_sampling_line_ids">
                                    <list editable="bottom">
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="lot_id"/>
                                        <field name="product_uom_id" options="{'no_open':True,'no_create':True}"/>
                                        <field name="product_uom_category_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dw_sampling" model="ir.actions.act_window">
        <field name="name">Testing</field>
        <field name="res_model">dw.quality.sampling</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
            id="menu_quality_sampling"
            name="Testing"
            action="action_dw_sampling"
            parent="dw_quality.quality_control_menu_product"
            sequence="60"/>
</odoo>
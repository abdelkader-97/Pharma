<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dw_analyse_test_view_tree" model="ir.ui.view">
        <field name="name">dw.analyse.test.view.tree</field>
        <field name="model">dw.analyse.test</field>
        <field name="arch" type="xml">
            <list string="Tests">
                <field name="name"/>
                <field name="code"/>
                <field name="description" widget="text"/>
            </list>
        </field>
    </record>
    <record id="dw_analyse_test_view_form" model="ir.ui.view">
        <field name="name">dw.analyse.test.view.form</field>
        <field name="model">dw.analyse.test</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="description" widget="text"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dw_analyse_test" model="ir.actions.act_window">
        <field name="name">Test</field>
        <field name="res_model">dw.analyse.test</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
            id="menu_analyse_config_dw_analyse_test"
            name="Tests"
            action="action_dw_analyse_test"
            parent="dw_quality_control.menu_analyse_report"
            />
</odoo>
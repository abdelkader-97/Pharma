<odoo>

    <record id="sample_request_form_view" model="ir.ui.view">
        <field name="name">quality.sample.request.form</field>
        <field name="model">quality.sample.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,validate"/>


                    <button name="action_confirm" string="Confirm"
                            class="btn-primary"
                            invisible="state not in  ['draft']"
                            type="object"/>
                    <button name="action_validate" string="Validate"
                            class="btn-primary"
                            invisible="state not in  ['confirm']"
                            type="object"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state not in  ['draft']"
                            class="btn-secondary"/>
                    <button
                            name="action_canceled" string="Cancel"
                            type="object"
                            invisible="state in  ['validate','cancel']"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button class="oe_stat_button" type="object" name="action_quality_check" icon="fa-list-alt"
                                invisible="not quality_check_id">
                            <field name="quality_check_id" string="Quality Check" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_stock_picking" icon="fa-exchange"
                                invisible="not picking_id">
                            <field name="picking_id" string="Transfer" widget="statinfo"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="product_id" readonly="state not in ['draft','confirm'] or quality_check_id"
                                   options='{"no_create":True}'/>
                            <field name="quality_check_id" invisible="1"/>
                            <field name="lot_id" readonly="state not in ['draft','confirm'] or quality_check_id"/>
                            <field name="user_id" readonly="state not in ['draft','confirm']"/>
                            <field name="request_time" readonly="state not in ['draft','confirm']"/>
                            <field name="dw_sampling_id" readonly="state not in ['draft','confirm']"
                                   options='{"no_create":True}' required="1"/>
                        </group>
                        <group>
                            <field name="type_id" readonly="state not in ['draft']"/>
                            <field name="location_id" readonly="state not in ['draft'] or quality_check_id"/>
                            <field name="location_dest_id" readonly="state not in ['draft']"/>
                            <field name="validation_time" invisible="state not in ['validate']"/>
                            <field name="validation_by" invisible="state not in ['validate']"/>
                            <field name="company_id" readonly="state not in ['draft'] or quality_check_id"
                                   options='{"no_create":True}'/>
                        </group>
                        <notebook>
                            <page name="components" string="Components">
                                <field name="dw_sampling_line_ids" string="Samling Lines" options="{'no_create': True}">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id" options="{'no_open':True,'no_create':True}"/>
                                        <field name="product_uom_category_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sample_request_tree_view" model="ir.ui.view">
        <field name="name">quality.sample.request.tree</field>
        <field name="model">quality.sample.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="quality_check_id" optional="hide"/>
                <field name="lot_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="request_time" optional="show"/>
                <field name="validation_time" optional="hide"/>
                <field name="validation_by" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_quality_sample_request" model="ir.actions.act_window">
        <field name="name">Sample Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">quality.sample.request</field>
    </record>

    <menuitem
            id="menu_quality_sample_request"
            name="Sample Request"
            action="action_quality_sample_request"
            parent="dw_quality.menu_quality_control"
    />

</odoo>
<odoo>
    <data>
        <record model="ir.module.category" id="dw_quality">
            <field name="name">Quality Control</field>
            <field name="description">Helps you manage your quality-related processes.</field>
            <field name="sequence">8</field>
        </record>

        <record id="group_quality_check_raw_material" model="res.groups">
            <field name="name">Raw materials</field>
            <field name="comment">The user will have access to the Quality check for raw materials.</field>
            <field name="category_id" ref="dw_quality"/>
        </record>

        <record id="group_quality_check_final_product" model="res.groups">
            <field name="name">Final products</field>
            <field name="comment">The user will have access to the Quality check for Final products.</field>
            <field name="category_id" ref="dw_quality"/>
        </record>
    </data>
    <data noupdate="1">

        <record id="quality_check_model_comp_rule" model="ir.rule">
            <field name="name">Quality Check Model multi company rule</field>
            <field name="model_id" ref="model_dw_quality_check_model"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <record id="quality_check_product_model_comp_rule" model="ir.rule">
            <field name="name">Quality Check Product Model multi company rule</field>
            <field name="model_id" ref="model_dw_quality_check_product_model"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>


    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="stock_storage_category_form">
            <field name="name">stock.storage.category.form</field>
            <field name="model">stock.storage.category</field>
            <field name="inherit_id" ref="stock.stock_storage_category_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='allow_new_product']" position="after">
                    <field name="perform_transfer"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
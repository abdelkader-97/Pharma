<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_cancel_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.cancel.wizard.form</field>
        <field name="model">stock.lot.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Stock Lot">
                <group>
                    <group name="non_conform" string="Reason">
                        <field name="status" required="1"/>
                        <field name="reason_id" required="1"/>
                        <field name="note"/>
                    </group>
                    <group name="transfer" string="Transfer">
                        <field name="fail_location_id"/>
                    </group>
                    
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_cancel_reason_lot" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>



<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_sub_lot_register_form" model="ir.ui.view">
        <field name="name">stock.lot.sub.lot.register.form</field>
        <field name="model">stock.lot.sub.lot.register</field>
        <field name="arch" type="xml">
            <form string="Sub-Lot Registration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="lot_id" string="Lot"/>
                            <field name="lot_id" readonly="1"/>
                        </h1>
                    </div>
                                            <group>
                            <field name="partial_liberation_qc" required="1"/>
                        </group>
                    <group>


                        <group name="non_conform" string="Reason" invisible="not partial_liberation_qc">
                            <field name="reason_id" required="partial_liberation_qc"/>
                            <field name="status" required="non_conform_qty!=0"/>
                        </group>
                        <group name="sub_lot" string="Sub-Lot" invisible="not partial_liberation_qc">
                            <field name="non_conform_qty" required="partial_liberation_qc"/>
                            <field name="non_conform_lot" required="partial_liberation_qc"/>
                            <field name="location_id" required="partial_liberation_qc"/>
                        </group>

                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm_sub_lot" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>


